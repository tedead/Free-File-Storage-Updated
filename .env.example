# Free File Storage - environment configuration
#
#   copy .env.example .env
#
# .env is gitignored; this template is committed so the available settings are
# documented without any real values being published.
#
# Everything here is optional. Anything left unset falls back to the default in
# config.php. A real environment variable (Apache SetEnv, IIS application
# settings, or the shell) overrides the value here.
#
# SECURITY: this file is plain text. If it must live inside the webroot, the
# deny rules in .htaccess and web.config have to be working -- a misconfigured
# server would otherwise serve your password verbatim. Putting it outside the
# webroot, or using config.local.php instead (PHP executes rather than displays),
# avoids the question entirely.

# --- Database ----------------------------------------------------------------

# Hostname or IP. For a named instance use SQLBOX\SQLEXPRESS -- a single
# backslash here, unlike in config.local.php where PHP needs it escaped.
FFS_DB_HOST=localhost

# 1433 for a default instance. Use 0 for a NAMED instance or LocalDB: those
# resolve by name, and sending a name and a port together fails.
FFS_DB_PORT=1433

FFS_DB_NAME=file_storage

# The SQL login created by sql/03_security.sql.
# Leave BOTH of these empty to use Windows authentication instead, which needs
# no password at all -- worth doing when the web server and SQL Server are on
# the same machine or in the same domain.
FFS_DB_USER=ffs_app
FFS_DB_PASS=

# Encryption for the connection. Keep this on for anything crossing a network.
FFS_DB_ENCRYPT=true

# true  = encrypted but the server certificate is NOT verified. Safe from
#         passive eavesdropping, not from an attacker who can redirect the
#         connection. Acceptable on a trusted LAN, or with LocalDB.
# false = encrypted and verified. What production should use. Requires a
#         certificate the client machine trusts.
FFS_DB_TRUST_CERT=false

# --- Storage -----------------------------------------------------------------

# Where uploads are written. Defaults to "User Directories" beside index.php.
# Somewhere outside the webroot is better; that directory ships with deny rules
# only as a fallback.
#FFS_STORAGE_PATH=C:\ffs-storage

# Largest accepted upload, in bytes. 67108864 = 64 MB.
# PHP's own upload_max_filesize and post_max_size still apply and are usually
# the lower of the two, so raise those in php.ini as well if you increase this.
FFS_MAX_UPLOAD_BYTES=67108864

# --- Application -------------------------------------------------------------

# bcrypt work factor. Each step doubles both the attacker's cost and your own
# login time. Measured on the development machine: 10 = 44ms, 12 = 164ms,
# 14 = 657ms. Raising it later is safe -- users are re-hashed on next login.
FFS_BCRYPT_COST=12

# How long success and notice messages stay on screen, in milliseconds.
# Errors ignore this and stay until dismissed. 0 disables auto-dismiss.
FFS_FLASH_DISMISS_MS=6000

# Set true once the site is served over HTTPS, so session cookies are marked
# Secure and never travel in the clear.
FFS_SECURE_COOKIES=false

# Shows stack traces in the browser. Never true on anything reachable by others:
# traces exclude function arguments, so credentials will not leak through them,
# but they still expose file paths and application internals.
FFS_DEBUG=false
