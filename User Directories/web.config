<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS counterpart to .htaccess: uploaded content must never be requested directly.
  accessPolicy="None" removes every handler, so nothing here is executable or servable.
-->
<configuration>
  <system.webServer>
    <handlers accessPolicy="None" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="User Directories" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
